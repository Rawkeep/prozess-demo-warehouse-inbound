ypoint x="58.0" y="318.0" /><di:waypoint x="370.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-1" bpmnElement="flow-1"><di:waypoint x="370.0" y="340.0" /><di:waypoint x="650.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-2" bpmnElement="flow-2"><di:waypoint x="650.0" y="340.0" /><di:waypoint x="930.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-3" bpmnElement="flow-3"><di:waypoint x="930.0" y="340.0" /><di:waypoint x="1185.0" y="325.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-4" bpmnElement="flow-4"><di:waypoint x="1185.0" y="325.0" /><di:waypoint x="1490.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-5" bpmnElement="flow-5"><di:waypoint x="1185.0" y="325.0" /><di:waypoint x="1490.0" y="540.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-6" bpmnElement="flow-6"><di:waypoint x="1490.0" y="340.0" /><di:waypoint x="1770.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-7" bpmnElement="flow-7"><di:waypoint x="1770.0" y="340.0" /><di:waypoint x="2018.0" y="318.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-8" bpmnElement="flow-8"><di:waypoint x="1490.0" y="540.0" /><di:waypoint x="1770.0" y="540.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-9" bpmnElement="flow-9"><di:waypoint x="1770.0" y="540.0" /><di:waypoint x="2018.0" y="318.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
