<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs-warehouse-inbound" targetNamespace="https://rawkeep.de/process-modeling"><bpmn:process id="proc-warehouse-inbound" name="Wareneingang &amp; Einlagerung" isExecutable="false"><bpmn:documentation>[Lager &amp; Logistik] Lieferavis per EDI, Wareneingangsbuchung in S/4, Qualitätsprüfung, Einlagerung oder Sperrbestand mit Lieferantenreklamation.</bpmn:documentation><bpmn:startEvent id="start" name="Lieferavis empfangen"><bpmn:documentation>Lieferant</bpmn:documentation></bpmn:startEvent><bpmn:serviceTask id="avis" name="Avis einlesen &amp; Anlieferung planen"><bpmn:documentation>EDI-Gateway</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="receive" name="Wareneingang buchen"><bpmn:documentation>SAP S/4HANA (MIGO)</bpmn:documentation></bpmn:serviceTask><bpmn:userTask id="qc" name="Qualitätsprüfung durchführen"><bpmn:documentation>Qualitätssicherung</bpmn:documentation></bpmn:userTask><bpmn:exclusiveGateway id="d-qc" name="Qualität in Ordnung?"><bpmn:documentation>Qualitätssicherung</bpmn:documentation></bpmn:exclusiveGateway><bpmn:userTask id="store" name="Ware einlagern"><bpmn:documentation>Lager</bpmn:documentation></bpmn:userTask><bpmn:serviceTask id="stock" name="Bestand aktualisieren"><bpmn:documentation>SAP S/4HANA</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="block" name="Sperrbestand buchen"><bpmn:documentation>SAP S/4HANA</bpmn:documentation></bpmn:serviceTask><bpmn:userTask id="claim" name="Lieferant reklamieren"><bpmn:documentation>Einkauf</bpmn:documentation></bpmn:userTask><bpmn:endEvent id="end" name="Wareneingang abgeschlossen" /><bpmn:sequenceFlow id="flow-0" sourceRef="start" targetRef="avis" /><bpmn:sequenceFlow id="flow-1" sourceRef="avis" targetRef="receive" /><bpmn:sequenceFlow id="flow-2" s